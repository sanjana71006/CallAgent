# CallMate AI Backend Environment Configuration

# Server Port
PORT=5000

# MongoDB Atlas Connection String
# Replace with your MongoDB Atlas connection string, e.g.:
# mongodb+srv://<username>:<password>@cluster0.mongodb.net/callmate_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/callmate_ai

# JWT Secret & Expiry for Session Authentication
JWT_SECRET=callmate_ai_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=30d

# Node Environment
NODE_ENV=development

# AI Provider Settings
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
